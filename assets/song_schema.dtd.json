{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/harpchart.schema.json",
  "title": "HarpChart v1.0",
  "description": "Schema for Harmonicon charts: one part, for a harmonica or (from format 1.8.0) another instrument.",
  "type": "object",
  "required": ["song", "timing", "track", "scoring"],
  "additionalProperties": false,

  "oneOf": [
    { "required": ["harmonica"], "not": { "required": ["instrument"] } },
    { "required": ["instrument"], "not": { "required": ["harmonica"] } }
  ],

  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Original song title or source material."
        },
        "license": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "audio_file": {
          "type": "string",
          "description": "Song Editor round-trip only — the backing-track filename shown/edited in its metadata form. Gameplay always loads song/*.ogg by convention regardless of this field."
        }
      }
    },

    "song": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "tempo_bpm",
        "key",
        "genre",
        "difficulty"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "description": "Musical genre used to group songs in the song picker."
        },
        "tempo_bpm": {
          "type": "number",
          "minimum": 20,
          "maximum": 300
        },
        "key": {
          "type": "string"
        },
        "time_signature": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "Informational default. When timing.time_signature_map is present it takes precedence."
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "intermediate",
            "advanced",
            "expert"
          ]
        },
        "feel": {
          "type": "string",
          "enum": [
            "straight",
            "shuffle"
          ],
          "description": "Metronome click subdivision this song is written for. Optional — omitting it leaves the player's current metronome feel choice untouched."
        }
      }
    },

    "timing": {
      "type": "object",
      "required": ["resolution", "tempo_map"],
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "type": "integer",
          "minimum": 1,
          "description": "Ticks per quarter note."
        },

        "tempo_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tick", "bpm"],
            "additionalProperties": false,
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "bpm": {
                "type": "number",
                "minimum": 20,
                "maximum": 300
              }
            }
          }
        },

        "time_signature_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tick", "time_signature"],
            "additionalProperties": false,
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "time_signature": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              }
            }
          }
        },

        "pickup_ticks": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of a pickup (anacrusis) in ticks: the music starts this far before bar 1. The pickup is the end of an implied, unnumbered bar 0. Added in format 1.4.0."
        },

        "repeats": {
          "type": "array",
          "description": "Repeat signs. The chart stores the score as written; the loader plays each passage out once per pass, taking endings on the passes they list. Added in format 1.5.0.",
          "items": {
            "type": "object",
            "required": ["start_tick", "end_tick"],
            "additionalProperties": false,
            "properties": {
              "start_tick": { "type": "integer", "minimum": 0 },
              "end_tick": {
                "type": "integer",
                "minimum": 0,
                "description": "The repeat sign: playback jumps back to start_tick from here until the last pass."
              },
              "times": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8,
                "description": "Total passes, the first included. Defaults to 2."
              },
              "endings": {
                "type": "array",
                "description": "Volta brackets. One inside the passage is skipped on passes it doesn't list; one starting at or after end_tick is only reached after the last pass.",
                "items": {
                  "type": "object",
                  "required": ["start_tick", "end_tick", "passes"],
                  "additionalProperties": false,
                  "properties": {
                    "start_tick": { "type": "integer", "minimum": 0 },
                    "end_tick": { "type": "integer", "minimum": 0 },
                    "passes": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "integer", "minimum": 1, "maximum": 8 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "instrument": {
      "description": "A non-harmonica instrument, used instead of harmonica: a guitar (format 1.8.0), a flute (format 1.9.0) or a piano (format 1.10.0).",
      "oneOf": [
        {
          "type": "object",
          "description": "A guitar (format 1.8.0). Strings are note names, string 1 (the highest) first; frets count from the nut and capo is the fret the capo sits on.",
          "required": ["type", "strings", "frets"],
          "additionalProperties": false,

          "properties": {
            "type": {
              "type": "string",
              "enum": ["guitar"]
            },

            "strings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "string",
                "pattern": "^[A-G][#b]?[0-9]$"
              }
            },

            "frets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36
            },

            "capo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },

            "body": {
              "type": "string",
              "enum": ["electric", "acoustic"]
            }
          }
        },
        {
          "type": "object",
          "description": "A fretted electric bass (format 1.11.0). Strings are note names, string 1 (the highest) first; frets count from the nut and capo is the fret the capo sits on.",
          "required": ["type", "strings", "frets"],
          "additionalProperties": false,

          "properties": {
            "type": {
              "type": "string",
              "enum": ["bass"]
            },

            "strings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "string",
                "pattern": "^[A-G][#b]?[0-9]$"
              }
            },

            "frets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36
            },

            "capo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        {
          "type": "object",
          "description": "A Boehm flute (format 1.9.0). foot is its foot joint: c reaches C4, b reaches B3. Defaults to c.",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["flute"] },
            "foot": { "type": "string", "enum": ["c", "b"] }
          }
        },
        {
          "type": "object",
          "description": "A piano (format 1.10.0). keys is the keyboard's size: 88 (A0 to C8, the default), 76 (E1 to G7), 61 (C2 to C7) or 49 (C2 to C6). Its events name only their note.",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["piano"] },
            "keys": { "type": "integer", "enum": [88, 76, 61, 49] }
          }
        }
      ]
    },

    "harmonica": {
      "type": "object",
      "required": ["type", "holes"],
      "unevaluatedProperties": false,

      "properties": {
        "type": {
          "type": "string",
          "enum": ["diatonic", "chromatic"]
        },

        "holes": {
          "type": "integer",
          "minimum": 1
        },

        "position": {
          "type": "string"
        },

        "scale": {
          "type": "string",
          "enum": [
            "first_position",
            "second_position",
            "third_position",
            "major",
            "minor_pentatonic",
            "country"
          ],
          "description": "Which scale the Song Editor colors notes against. first_position/second_position/third_position all use the blues scale, rooted at the harp's own key/a 5th up/a whole step up respectively; the others are the named scale rooted on the harp's own key. Optional, defaults to first_position."
        }
      },

      "if": {
        "properties": {
          "type": {
            "const": "diatonic"
          }
        }
      },

      "then": {
        "required": ["bending_profile"],

        "properties": {
          "holes": {
            "const": 10
          },

          "bending_profile": {
            "type": "string",
            "enum": [
              "richter_standard",
              "country_tuned",
              "paddy_richter",
              "natural_minor"
            ]
          },

          "layout": {
            "type": "object",
            "additionalProperties": false,

            "properties": {
              "blow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 10,
                "maxItems": 10
              },

              "draw": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 10,
                "maxItems": 10
              }
            }
          }
        }
      },

      "else": {
        "properties": {
          "holes": {
            "type": "integer",
            "enum": [10, 12, 16]
          },

          "layout": {
            "type": "object",
            "additionalProperties": false,

            "properties": {
              "blow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },

              "draw": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },

              "blow_slide": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },

              "draw_slide": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },

    "track": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",

        "required": [
          "duration",
          "events"
        ],

        "additionalProperties": false,

        "properties": {
          "id": {
            "type": "string",
            "description": "Human-readable label for debugging and log output."
          },

          "time": {
            "type": "number",
            "minimum": 0
          },

          "tick": {
            "type": "integer",
            "minimum": 0
          },

          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },

          "phrase": {
            "type": "string"
          },

          "groove": {
            "type": "string"
          },

          "chord": {
            "type": "string",
            "description": "Optional chord symbol in effect at this phrase onset, such as G7alt or Bbmaj7."
          },

          "play_mode": {
            "type": "string",
            "enum": [
              "single",
              "chord",
              "split"
            ]
          },

          "call": {
            "type": "boolean",
            "description": "Marks this item as part of a call-and-response phrase. Before a maximal run of consecutive call:true items, the game synthesizes and plays their notes as a one-shot audio demo, then always waits for the player to echo them. Absent = false, an ordinary item."
          },

          "lyric": {
            "type": "string",
            "description": "The syllable sung when this item starts, shown karaoke-style in gameplay. A trailing '-' joins it to the next syllable of the same word; a leading '/' starts a new line. Added in format 1.6.0."
          },

          "events": {
            "type": "array",
            "minItems": 1,

            "items": {
              "type": "object",

              "description": "A harmonica event names hole and action; a stringed instrument's names position and note; a flute's names its note, and optionally which fingering. Which one a chart needs is validated by the engine against its instrument.",

              "anyOf": [
                { "required": ["hole", "action"] },
                { "required": ["position", "note"] },
                { "required": ["note"], "not": { "anyOf": [{ "required": ["hole"] }, { "required": ["position"] }] } }
              ],

              "additionalProperties": false,

              "properties": {
                "hole": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Must not exceed harmonica.holes. This is validated by the engine."
                },

                "action": {
                  "type": "string",
                  "enum": [
                    "blow",
                    "draw"
                  ]
                },

                "position": {
                  "type": "object",
                  "description": "A string and fret, string 1 the highest and frets counted from the capo, as tab writes them.",
                  "required": ["string", "fret"],
                  "additionalProperties": false,
                  "properties": {
                    "string": { "type": "integer", "minimum": 1 },
                    "fret": { "type": "integer", "minimum": 0 }
                  }
                },

                "fingering": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Which of a flute note's fingerings (format 1.9.0): 0 or absent the standard one, then its alternates in the engine's table order."
                },

                "note": {
                  "type": "string",
                  "pattern": "^[A-G][#b]?[0-9]$"
                },

                "modifiers": {
                  "type": "array",

                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,

                  "description": "Modifier compatibility is validated by the engine.",

                  "items": {
                    "type": "object",

                    "required": ["type"],

                    "unevaluatedProperties": false,

                    "properties": {
                      "type": {
                        "type": "string",

                        "enum": [
                          "bend",
                          "overblow",
                          "overdraw",
                          "slide",
                          "harmonic",
                          "vibrato",
                          "wah-wah"
                        ]
                      }
                    },

                    "oneOf": [
                      {
                        "properties": {
                          "type": {
                            "const": "bend"
                          },

                          "semitones": {
                            "type": "number",
                            "minimum": -3,
                            "maximum": 3,
                            "not": { "const": 0 },
                            "description": "Negative bends a harmonica reed down; positive bends a string up. The engine checks the sign against the chart's instrument."
                          },

                          "intensity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },

                        "required": [
                          "semitones"
                        ]
                      },

                      {
                        "properties": {
                          "type": {
                            "const": "overblow"
                          }
                        }
                      },

                      {
                        "properties": {
                          "type": {
                            "const": "overdraw"
                          }
                        }
                      },

                      {
                        "properties": {
                          "type": {
                            "const": "slide"
                          }
                        }
                      },

                      {
                        "properties": {
                          "type": {
                            "const": "harmonic"
                          }
                        }
                      },

                      {
                        "properties": {
                          "type": {
                            "const": "vibrato"
                          },

                          "oscillation_hz": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },

                          "intensity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },

                        "required": [
                          "oscillation_hz"
                        ]
                      },

                      {
                        "properties": {
                          "type": {
                            "const": "wah-wah"
                          },

                          "oscillation_hz": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },

                          "intensity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },

                        "required": [
                          "oscillation_hz"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },

        "oneOf": [
          {
            "required": ["time"]
          },

          {
            "required": ["tick"]
          }
        ]
      }
    },

    "loop": {
      "type": "object",

      "required": [
        "start_index",
        "end_index"
      ],

      "additionalProperties": false,

      "properties": {
        "type": {
          "type": "string",

          "enum": [
            "intro",
            "verse",
            "chorus",
            "bridge",
            "outro",
            "full"
          ]
        },

        "repeat": {
          "type": "boolean"
        },

        "start_index": {
          "type": "integer",
          "minimum": 0
        },

        "end_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "scoring": {
      "type": "object",

      "required": [
        "perfect_window_ms",
        "good_window_ms",
        "miss_window_ms"
      ],

      "additionalProperties": false,

      "properties": {
        "perfect_window_ms": {
          "type": "integer",
          "minimum": 1
        },

        "good_window_ms": {
          "type": "integer",
          "minimum": 1
        },

        "miss_window_ms": {
          "type": "integer",
          "minimum": 1
        },

        "combo": {
          "type": "object",

          "required": [
            "enabled",
            "base_multiplier",
            "step_multiplier",
            "max_multiplier"
          ],

          "additionalProperties": false,

          "properties": {
            "enabled": {
              "type": "boolean"
            },

            "base_multiplier": {
              "type": "number",
              "minimum": 1
            },

            "step_multiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            },

            "max_multiplier": {
              "type": "number",
              "exclusiveMinimum": 1
            },

            "decay_ms": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },

        "style_bonus": {
          "type": "object",

          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
