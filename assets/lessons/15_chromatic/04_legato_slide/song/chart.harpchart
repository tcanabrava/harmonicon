{"metadata":{"format_version":"1.0.0","author":"Harmonicon","source":"Original exercise","license":"MIT","description":"Connected natural-to-slide chromatic phrases."},"song":{"title":"Legato Slide Phrasing","artist":"Harmonicon Lessons","tempo_bpm":60,"key":"C","time_signature":"4/4","difficulty":"advanced"},"timing":{"resolution":480,"tempo_map":[{"tick":0,"bpm":60}]},"harmonica":{"type":"chromatic","holes":12,"layout":{"blow":["C4","E4","G4","C5","C5","E5","G5","C6","C6","E6","G6","C7"],"draw":["D4","F4","A4","B4","D5","F5","A5","B5","D6","F6","A6","B6"],"blow_slide":["C#4","F4","G#4","C#5","C#5","F5","G#5","C#6","C#6","F6","G#6","C#7"],"draw_slide":["D#4","F#4","A#4","C5","D#5","F#5","A#5","C6","D#6","F#6","A#6","C7"]}},"track":[{"id":"l1","time":0.0,"duration":1.2,"play_mode":"single","events":[{"hole":1,"action":"blow","note":"C4"}],"phrase":"Keep one connected breath"},{"id":"l2","time":1.25,"duration":1.2,"play_mode":"single","events":[{"hole":1,"action":"blow","note":"C#4","modifiers":[{"type":"slide"}]}]},{"id":"l3","time":2.5,"duration":1.2,"play_mode":"single","events":[{"hole":1,"action":"draw","note":"D4"}]},{"id":"l4","time":3.75,"duration":1.2,"play_mode":"single","events":[{"hole":1,"action":"draw","note":"D#4","modifiers":[{"type":"slide"}]}]},{"id":"l5","time":5.0,"duration":1.6,"play_mode":"single","events":[{"hole":2,"action":"blow","note":"E4"}]},{"id":"l6","time":7.0,"duration":1.2,"play_mode":"single","events":[{"hole":2,"action":"draw","note":"F4"}],"phrase":"Release and press without a gap"},{"id":"l7","time":8.25,"duration":1.2,"play_mode":"single","events":[{"hole":2,"action":"draw","note":"F#4","modifiers":[{"type":"slide"}]}]},{"id":"l8","time":9.5,"duration":1.6,"play_mode":"single","events":[{"hole":3,"action":"blow","note":"G4"}]}],"scoring":{"perfect_window_ms":160,"good_window_ms":320,"miss_window_ms":540}}
