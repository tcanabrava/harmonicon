{"metadata":{"format_version":"1.0.0","author":"Harmonicon","source":"Original exercise","license":"MIT","description":"Slide-button press and release coordination on one breath direction."},"song":{"title":"Button Coordination","artist":"Harmonicon Lessons","tempo_bpm":60,"key":"C","time_signature":"4/4","difficulty":"intermediate"},"timing":{"resolution":480,"tempo_map":[{"tick":0,"bpm":60}]},"harmonica":{"type":"chromatic","holes":12,"layout":{"blow":["C4","E4","G4","C5","C5","E5","G5","C6","C6","E6","G6","C7"],"draw":["D4","F4","A4","B4","D5","F5","A5","B5","D6","F6","A6","B6"],"blow_slide":["C#4","F4","G#4","C#5","C#5","F5","G#5","C#6","C#6","F6","G#6","C#7"],"draw_slide":["D#4","F#4","A#4","C5","D#5","F#5","A#5","C6","D#6","F#6","A#6","C7"]}},"track":[{"id":"b1","time":0.0,"duration":1.0,"play_mode":"single","events":[{"hole":1,"action":"blow","note":"C4"}],"phrase":"Press without interrupting the air"},{"id":"b2","time":1.5,"duration":1.0,"play_mode":"single","events":[{"hole":1,"action":"blow","note":"C#4","modifiers":[{"type":"slide"}]}]},{"id":"b3","time":3.0,"duration":1.0,"play_mode":"single","events":[{"hole":1,"action":"blow","note":"C4"}]},{"id":"b4","time":4.5,"duration":1.0,"play_mode":"single","events":[{"hole":1,"action":"draw","note":"D4"}]},{"id":"b5","time":6.0,"duration":1.0,"play_mode":"single","events":[{"hole":1,"action":"draw","note":"D#4","modifiers":[{"type":"slide"}]}]},{"id":"b6","time":7.5,"duration":1.0,"play_mode":"single","events":[{"hole":1,"action":"draw","note":"D4"}]},{"id":"b7","time":9.0,"duration":0.7,"play_mode":"single","events":[{"hole":2,"action":"blow","note":"E4"}]},{"id":"b8","time":10.0,"duration":0.7,"play_mode":"single","events":[{"hole":2,"action":"blow","note":"F4","modifiers":[{"type":"slide"}]}]},{"id":"b9","time":11.0,"duration":0.7,"play_mode":"single","events":[{"hole":2,"action":"blow","note":"E4"}]}],"scoring":{"perfect_window_ms":150,"good_window_ms":300,"miss_window_ms":520}}
